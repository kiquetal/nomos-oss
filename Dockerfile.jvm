####
# Multi-stage Dockerfile for Quarkus JVM mode
#
# Build:
#   docker build -f Dockerfile.jvm -t me.cresterida/nomos-oss:1.0.0-jvm .
#
# Run:
#   docker run -i --rm -p 8080:8080 -e NEO4J_URI=bolt://host.docker.internal:7687 me.cresterida/nomos-oss:1.0.0-jvm
###

# --- Build stage ---
FROM eclipse-temurin:21-jdk-alpine AS build
WORKDIR /build

# Cache Maven dependencies
COPY .mvn .mvn
COPY mvnw pom.xml ./
RUN ./mvnw dependency:go-offline -B

# Build the application
COPY src src
RUN ./mvnw package -DskipTests -B

# --- Runtime stage ---
FROM eclipse-temurin:21-jre-alpine

ARG JAVA_OPTS_EXTRA=""
ENV LANGUAGE='en_US:en' \
    JAVA_OPTS="-Dquarkus.http.host=0.0.0.0 -Djava.util.logging.manager=org.jboss.logmanager.LogManager ${JAVA_OPTS_EXTRA}"

# Create non-root user
RUN addgroup -S quarkus && adduser -S quarkus -G quarkus
WORKDIR /deployments

# Copy application layers (optimized for Docker layer caching)
COPY --from=build --chown=quarkus:quarkus /build/target/quarkus-app/lib/ ./lib/
COPY --from=build --chown=quarkus:quarkus /build/target/quarkus-app/*.jar ./
COPY --from=build --chown=quarkus:quarkus /build/target/quarkus-app/app/ ./app/
COPY --from=build --chown=quarkus:quarkus /build/target/quarkus-app/quarkus/ ./quarkus/

EXPOSE 8080
USER quarkus

ENTRYPOINT ["java", "-jar", "/deployments/quarkus-run.jar"]
